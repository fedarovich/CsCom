<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Late binding with C# dynamic for the COM objects of CsCom.Runtime. Like those of CsCom.Runtime, the sources of this project
    are also embedded into CsCom.Core and emitted into generated projects that use the "public" or "internal" support code mode
    with dynamic: no implicit usings, no assembly-level attributes, file-scoped "CsCom.Runtime" namespace only, and only the
    public API of CsCom.Runtime.
  -->

  <PropertyGroup>
    <!-- The target frameworks and the C# versions of CsCom.Runtime (see CsCom.Runtime.csproj). -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>default</LangVersion>
    <!-- The types of CsCom.Runtime are extended, so they share its namespace. -->
    <RootNamespace>CsCom.Runtime</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <!--
      dynamic is not supported by Native AOT, but the AOT analyzers ensure that the API that requires dynamic code is annotated
      with [RequiresDynamicCode], so that AOT apps get warnings where they use it. The same applies to generated projects that
      embed these sources.
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <!-- The symbols package, which nuget.org serves from its symbol server, so that the users can step into the late binding. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Description>Late binding with C# dynamic for the COM interop code generated by CsCom: ComActivator.CreateDynamicInstance, AsDynamic and the events of dynamic objects.</Description>
    <PackageTags>COM;interop;dynamic;IDispatch;late-binding</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CsCom.Runtime\CsCom.Runtime.csproj" />
  </ItemGroup>

</Project>
