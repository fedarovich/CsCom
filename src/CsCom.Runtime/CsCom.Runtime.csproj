<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The sources of this project are also embedded into CsCom.Core and emitted into generated projects
    when the "public" or "internal" support code mode is used. Keep them self-contained:
    no implicit usings, no assembly-level attributes, file-scoped "CsCom.Runtime" namespace only.
  -->

  <PropertyGroup>
    <!-- Generated interfaces that derive from IDispatch must target the same framework as this assembly (SYSLIB1230). -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>$(CsComLocalPackagesDir)</PackageOutputPath>
    <Description>Runtime support library for the COM interop assemblies generated by CsCom using source-generated COM interop.</Description>
    <PackageTags>COM;interop;ComWrappers;IDispatch;NativeAOT</PackageTags>
  </PropertyGroup>

</Project>
