<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The sources of this project are also embedded into CsCom.Core and emitted into generated projects
    when the "public" or "internal" support code mode is used. Keep them self-contained:
    no implicit usings, no assembly-level attributes, file-scoped "CsCom.Runtime" namespace only.
  -->

  <PropertyGroup>
    <!--
      A build for each supported .NET version: generated interfaces that derive from IDispatch must target the same framework
      as this assembly (SYSLIB1230). Each build uses the default C# version of its framework, so that the net10.0 build keeps
      the sources, which generated projects compile with C# 14 or later, compatible with C# 14.
    -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>default</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <!-- The symbols package, which nuget.org serves from its symbol server, so that the users can step into the support code. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Description>Runtime support library for the COM interop assemblies generated by CsCom using source-generated COM interop.</Description>
    <PackageTags>COM;interop;ComWrappers;IDispatch;NativeAOT</PackageTags>
  </PropertyGroup>

</Project>
