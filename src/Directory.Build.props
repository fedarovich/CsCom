<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Pavel Fedarovich</Authors>
    <Copyright>Copyright (c) 2026 fedarovich</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/fedarovich/CsCom</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fedarovich/CsCom</RepositoryUrl>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Local feed that receives the CsCom.Runtime package on every build. -->
    <CsComLocalPackagesDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'artifacts', 'packages'))</CsComLocalPackagesDir>
  </PropertyGroup>

</Project>
