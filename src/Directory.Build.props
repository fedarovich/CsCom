<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Pavel Fedarovich</Authors>
    <Copyright>Copyright (c) 2026 fedarovich</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/fedarovich/CsCom</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fedarovich/CsCom</RepositoryUrl>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    The icon of the packages, which is also the logo of the documentation site, and the readme of each package, the README.md
    next to its project, which nuget.org shows. The condition sees the IsPackable of the project, because items are evaluated
    after all the properties. CsCom.Build packs both through its nuspec. The readme is included rather than updated, because a
    project with several target frameworks is packed by its outer build, which has no default items.
  -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)..\icon.png" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      Reproducible builds: the output only depends on the sources, and the CI build maps the source paths to /_/ so that it does
      not depend on the build machine either. The SDK adds Source Link and embeds the untracked sources into the PDBs.
    -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Local feed that receives the packages of dotnet pack, from which the integration tests restore them. -->
    <CsComLocalPackagesDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'artifacts', 'packages'))</CsComLocalPackagesDir>
    <PackageOutputPath>$(CsComLocalPackagesDir)</PackageOutputPath>
  </PropertyGroup>

</Project>
