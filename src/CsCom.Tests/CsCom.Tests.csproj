<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The tests run on each supported .NET version, and the integration tests build projects for the version they run on. -->
    <TargetFrameworks>net10.0-windows;net11.0-windows</TargetFrameworks>
    <IsTestProject>true</IsTestProject>
    <!-- The event tests build DISPPARAMS by hand. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
    <PackageReference Include="Verify.MSTest" />
    <!-- The MSBuild assemblies that the task of CsCom.Build needs at run time. -->
    <PackageReference Include="Microsoft.Build.Framework" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CsCom\CsCom.csproj" />
    <ProjectReference Include="..\CsCom.Core\CsCom.Core.csproj" />

    <!-- Tested directly, and their packages are restored from the local feed by the integration tests. -->
    <ProjectReference Include="..\CsCom.Runtime\CsCom.Runtime.csproj" />
    <ProjectReference Include="..\CsCom.Runtime.Dynamic\CsCom.Runtime.Dynamic.csproj" />
    <ProjectReference Include="..\CsCom.Build\CsCom.Build.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestAssets\CsComTest.tlb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="TestAssets\CsComDrawing.tlb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="TestAssets\Interop.CsComTest.dll" CopyToOutputDirectory="PreserveNewest" />

    <!-- The snapshots of the generated code are C# files that must not be compiled. -->
    <Compile Remove="Snapshots\**" />
    <None Include="Snapshots\**" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CsComLocalPackagesDir</_Parameter1>
      <_Parameter2>$(CsComLocalPackagesDir)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CsComTargetFramework</_Parameter1>
      <_Parameter2>$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
