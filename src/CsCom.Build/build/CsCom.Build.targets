<Project>

  <UsingTask TaskName="CsCom.Build.CsComGenerate" AssemblyFile="$(MSBuildThisFileDirectory)..\tasks\netstandard2.0\CsCom.Build.dll" />

  <PropertyGroup>
    <!-- The generated files are written into the intermediate output, per target framework. -->
    <CsComOutputPath Condition="'$(CsComOutputPath)' == ''">$(IntermediateOutputPath)CsCom\</CsComOutputPath>
    <CsComSupportNamespace Condition="'$(CsComSupportNamespace)' == ''">$(RootNamespace).ComSupport</CsComSupportNamespace>
    <!-- The cscom tool generates the code. -->
    <_CsComToolPath>$(MSBuildThisFileDirectory)..\tools\net10.0\cscom.dll</_CsComToolPath>
    <!-- The dotnet executable of the SDK: DOTNET_HOST_PATH is set by the .NET CLI, NetCoreRoot by the SDK in Visual Studio. -->
    <_CsComDotNetHostPath>$(DOTNET_HOST_PATH)</_CsComDotNetHostPath>
    <_CsComDotNetHostPath Condition="'$(_CsComDotNetHostPath)' == '' and '$(NetCoreRoot)' != ''">$(NetCoreRoot)dotnet.exe</_CsComDotNetHostPath>
  </PropertyGroup>

  <!--
    Solution Explorer shows the items of the evaluation, so the files that the last build generated are included here: those in
    the intermediate output (or outside the project) under the virtual folder CsComGeneratedFilesFolder, and those in a folder of
    the project in place. The default globs skip the output folder, which keeps the files from being compiled twice and hides the
    state files. The files are only included with references, so that the files of removed references are not compiled.
  -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(CsComOutputPath)**</DefaultItemExcludes>
    <_CsComOutputFullPath>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(CsComOutputPath)').ToUpperInvariant())</_CsComOutputFullPath>
    <_CsComIntermediateFullPath>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)').ToUpperInvariant())</_CsComIntermediateFullPath>
    <_CsComProjectFullPath>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)').ToUpperInvariant())</_CsComProjectFullPath>
    <_CsComOutputInIntermediate>$(_CsComOutputFullPath.StartsWith('$(_CsComIntermediateFullPath)'))</_CsComOutputInIntermediate>
    <_CsComOutputInProject>$(_CsComOutputFullPath.StartsWith('$(_CsComProjectFullPath)'))</_CsComOutputInProject>
    <_CsComLinkGeneratedFiles>false</_CsComLinkGeneratedFiles>
    <_CsComLinkGeneratedFiles Condition="'$(_CsComOutputInIntermediate)' == 'true' or '$(_CsComOutputInProject)' != 'true'">true</_CsComLinkGeneratedFiles>
  </PropertyGroup>

  <ItemGroup Condition="'$(CsComShowGeneratedFiles)' == 'true' and '@(CsComReference)' != ''">
    <Compile Include="$(CsComOutputPath)**\*.cs"
             CsComGenerated="true"
             Link="$(CsComGeneratedFilesFolder)\%(RecursiveDir)%(Filename)%(Extension)"
             Condition="'$(_CsComLinkGeneratedFiles)' == 'true'" />
    <Compile Include="$(CsComOutputPath)**\*.cs" CsComGenerated="true" Condition="'$(_CsComLinkGeneratedFiles)' != 'true'" />
  </ItemGroup>

  <!--
    Generates the code before the compilation, also in the design-time builds of Visual Studio, so that IntelliSense sees the
    generated types. The generator only runs when the items, the properties or the files they read changed.
  -->
  <Target Name="CsComGenerate" BeforeTargets="CoreCompile" Condition="'@(CsComReference)' != ''">
    <CsComGenerate References="@(CsComReference)"
                   Libraries="@(CsComLibrary)"
                   ProjectDirectory="$(MSBuildProjectDirectory)"
                   OutputDirectory="$(CsComOutputPath)"
                   CsComPath="$(_CsComToolPath)"
                   DotNetHostPath="$(_CsComDotNetHostPath)"
                   TargetFramework="$(TargetFramework)"
                   LanguageVersion="$(LangVersion)"
                   SupportCode="$(CsComSupportCode)"
                   SupportNamespace="$(CsComSupportNamespace)"
                   DisableRuntimeMarshalling="$(CsComDisableRuntimeMarshalling)"
                   EventStyle="$(CsComEventStyle)"
                   StructProperties="$(CsComStructProperties)"
                   OverloadsForDefaultValues="$(CsComOverloadsForDefaultValues)"
                   DateMarshalling="$(CsComDateMarshalling)"
                   CurrencyMarshalling="$(CsComCurrencyMarshalling)"
                   BoolMarshalling="$(CsComBoolMarshalling)"
                   BstrMarshalling="$(CsComBstrMarshalling)"
                   SafeArrayMarshalling="$(CsComSafeArrayMarshalling)">
      <Output TaskParameter="GeneratedFiles" ItemName="_CsComGeneratedFile" />
    </CsComGenerate>

    <ItemGroup>
      <!-- The files of the evaluation are replaced by those that the generator wrote, which can have changed since. -->
      <_CsComEvaluatedFile Include="@(Compile)" Condition="'%(Compile.CsComGenerated)' == 'true'" />
      <Compile Remove="@(_CsComEvaluatedFile)" />
      <Compile Include="@(_CsComGeneratedFile)" CsComGenerated="true" />
      <FileWrites Include="@(_CsComGeneratedFile);$(CsComOutputPath)cscom.request.json;$(CsComOutputPath)cscom.state" />
    </ItemGroup>

    <PropertyGroup>
      <!-- The generated code uses pointers. -->
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <!--
        The code that the COM source generator adds for public interfaces reports CA2256 when they derive from IDispatch of
        CsCom.Runtime, and CS1591 for the members of base interfaces that it declares without documentation. Analyzer
        configurations do not apply to generated code, so these warnings are disabled for the project.
      -->
      <NoWarn Condition="'$(CsComSuppressGeneratorWarnings)' == 'true' and '$(CsComSupportCode)' != 'internal'">$(NoWarn);CA2256</NoWarn>
      <NoWarn Condition="'$(CsComSuppressGeneratorWarnings)' == 'true' and '$(CsComSupportCode)' != 'internal' and '$(GenerateDocumentationFile)' == 'true'">$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
  </Target>

</Project>
