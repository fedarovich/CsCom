<Project>

  <!--
    CsCom.Build generates the interop code of the CsComReference items during the build:

      <CsComReference Include="C:\Windows\System32\scrrun.dll" />
      <CsComReference Include="Excel.Application" Namespace="Office.Excel" Config="excel.cscom.xml" />

    The properties below are the defaults of all the libraries, including those whose types the references only use; the
    metadata of the items (Namespace, ReferencePath, Config, EventStyle, StructProperties, OverloadsForDefaultValues,
    NamedIndexers, DateMarshalling, CurrencyMarshalling, BoolMarshalling, BstrMarshalling, SafeArrayMarshalling) override them.

    CsComLibrary items set the namespace and the configuration file of a library by its name, whether it is a reference or its
    types are only used by them; the Namespace metadata of a CsComReference wins:

      <CsComLibrary Include="stdole" Namespace="Ole.Interop" Config="stdole.cscom.xml" />
  -->
  <PropertyGroup>
    <!-- package (the CsCom.Runtime package), public or internal (the support code is generated into the project). -->
    <CsComSupportCode Condition="'$(CsComSupportCode)' == ''">package</CsComSupportCode>
    <!-- events, observable, interface or none. -->
    <CsComEventStyle Condition="'$(CsComEventStyle)' == ''">events</CsComEventStyle>
    <!-- auto or never. -->
    <CsComStructProperties Condition="'$(CsComStructProperties)' == ''">auto</CsComStructProperties>
    <CsComOverloadsForDefaultValues Condition="'$(CsComOverloadsForDefaultValues)' == ''">false</CsComOverloadsForDefaultValues>
    <!--
      none, classproperty (sheet.Range["A1"], through a property that returns a proxy class) or structmethod (sheet.Range()["A1"],
      through a method that returns a proxy struct): the indexer syntax of the parameterized properties other than the indexer.
    -->
    <CsComNamedIndexers Condition="'$(CsComNamedIndexers)' == ''">none</CsComNamedIndexers>
    <!--
      Generates the late binding with C# dynamic: the CreateDynamic methods of the coclasses, and the support code of
      CsCom.Runtime.Dynamic. With the package support code, the project must reference the CsCom.Runtime.Dynamic package.
    -->
    <CsComDynamic Condition="'$(CsComDynamic)' == ''">false</CsComDynamic>
    <!-- bcl, none or wrapper. -->
    <CsComDateMarshalling Condition="'$(CsComDateMarshalling)' == ''">bcl</CsComDateMarshalling>
    <CsComCurrencyMarshalling Condition="'$(CsComCurrencyMarshalling)' == ''">bcl</CsComCurrencyMarshalling>
    <CsComBoolMarshalling Condition="'$(CsComBoolMarshalling)' == ''">bcl</CsComBoolMarshalling>
    <!-- string, wrapper or none. -->
    <CsComBstrMarshalling Condition="'$(CsComBstrMarshalling)' == ''">string</CsComBstrMarshalling>
    <!-- array, sysarray, wrapper or none. -->
    <CsComSafeArrayMarshalling Condition="'$(CsComSafeArrayMarshalling)' == ''">array</CsComSafeArrayMarshalling>
    <!-- Source-generated COM interop marshals VARIANT and DECIMAL values only when runtime marshalling is disabled for the assembly. -->
    <CsComDisableRuntimeMarshalling Condition="'$(CsComDisableRuntimeMarshalling)' == ''">true</CsComDisableRuntimeMarshalling>
    <!-- Disables CA2256 and, when the project generates documentation, CS1591 for the code of the COM source generator. -->
    <CsComSuppressGeneratorWarnings Condition="'$(CsComSuppressGeneratorWarnings)' == ''">true</CsComSuppressGeneratorWarnings>
    <!--
      Shows the generated files in Solution Explorer: those in the intermediate output (CsComOutputPath by default) under the
      virtual folder CsComGeneratedFilesFolder, and those in a folder of the project in place.
    -->
    <CsComShowGeneratedFiles Condition="'$(CsComShowGeneratedFiles)' == ''">true</CsComShowGeneratedFiles>
    <CsComGeneratedFilesFolder Condition="'$(CsComGeneratedFilesFolder)' == ''">CsCom</CsComGeneratedFilesFolder>
  </PropertyGroup>

  <!--
    CsCom.Build also exports the type library of the assembly, like TlbExp, when CsComExportTypeLibrary is true: the public
    [GeneratedComInterface] interfaces and [GeneratedComClass] classes of the project, with the enumerations and structures
    that they use. The identity of the library is that of the assembly ([assembly: Guid], [assembly: TypeLibVersion]) unless
    CsComTypeLibraryName, CsComTypeLibraryGuid and CsComTypeLibraryVersion (major.minor) are set; CsComTypeLibraryPlatform
    is win32 or win64, and CsComTypeLibraryPath the file. The type library refers to the types of the code generated from
    type libraries in these libraries: those of the CsComReference items that are files, and registered ones. The type
    library of generated code of a referenced assembly that is not registered is a CsComTypeLibraryReference item:

      <CsComTypeLibraryReference Include="..\lib\Device.tlb" />
  -->
  <PropertyGroup>
    <CsComExportTypeLibrary Condition="'$(CsComExportTypeLibrary)' == ''">false</CsComExportTypeLibrary>
  </PropertyGroup>

  <ItemGroup>
    <!-- Type libraries and interop assemblies can be given the CsComReference build action in Visual Studio. -->
    <AvailableItemName Include="CsComReference" />
    <AvailableItemName Include="CsComTypeLibraryReference" />
  </ItemGroup>

</Project>
