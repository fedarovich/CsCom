<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Not net10.0-windows: .NET tools cannot target a platform. The assembly is marked as Windows-only instead. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>cscom</AssemblyName>
    <RootNamespace>CsCom</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cscom</ToolCommandName>
    <PackageId>CsCom</PackageId>
    <Description>Generates COM interop assemblies and projects from type libraries using source-generated COM interop, so that they can be used with Native AOT.</Description>
    <PackageTags>COM;interop;tlbimp;ComWrappers;NativeAOT</PackageTags>
    <!-- The bundled CsCom.Runtime package would be excluded by default. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CsCom.Core\CsCom.Core.csproj" />

    <!-- Builds the CsCom.Runtime package, which is bundled with the tool and used to build interop assemblies. -->
    <ProjectReference Include="..\CsCom.Runtime\CsCom.Runtime.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CsCom.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(CsComLocalPackagesDir)CsCom.Runtime.$(Version).nupkg"
          Link="packages\CsCom.Runtime.$(Version).nupkg"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
